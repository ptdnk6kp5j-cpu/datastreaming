# This file contains example environment variables for the datastreaming project.
# Do NOT place real passwords in this file. Copy it to `.env` and fill in your own values.
# The `.env` file is ignored by Git and is used by Docker Compose to inject variables
# into the Oracle, GoldenGate, and dbt containers. Each service receives only the
# variables explicitly defined under its `environment:` section.

##############################################
# SOR (Source Oracle Database)
##############################################

# SYS/SYSTEM password for the SOR CDB and PDB
SOR_ORACLE_ADMIN_PASSWORD=

# GoldenGate PDB admin user for SOR (used by Extract)
SOR_OGG_ADMIN_PASSWORD=

# GoldenGate common CDB user (C##OGGADMIN) for SOR
SOR_ROOT_OGGADMIN_PASSWORD=

# Application schemas in SOR (only exist in SOR)
SOR_TIZONE1_OWNER_PASSWORD=
SOR_TIZONE2_OWNER_PASSWORD=


##############################################
# DWH (Data Warehouse Oracle Database)
##############################################

# SYS/SYSTEM password for the DWH CDB and PDB
DWH_ORACLE_ADMIN_PASSWORD=

# GoldenGate PDB admin user for DWH (used by Replicat)
DWH_OGG_ADMIN_PASSWORD=


##############################################
# DWH – Landing Layer (Raw inbound tables)
##############################################

# Landing schemas for TIPLUS integration
DWH_LANDING_TIPLUS_AS_PASSWORD=
DWH_LANDING_TIPLUS_EU_PASSWORD=


##############################################
# DWH – Stage Layer (Pre-Raw-Vault normalization)
##############################################

DWH_STAGE_TIPLUS_AS_PASSWORD=
DWH_STAGE_TIPLUS_EU_PASSWORD=


##############################################
# DWH – Raw Vault Layer
##############################################

DWH_RAW_VAULT_PASSWORD=


##############################################
# DWH – Business Vault Layer
##############################################

DWH_BUSINESS_VAULT_PASSWORD=


##############################################
# DWH – Analytics / Presentation Layer
##############################################

DWH_ANALYTICS_PASSWORD=


##############################################
# GoldenGate (Microservices container)
##############################################

# OGG admin web user (for ogg23 container)
OGG_ADMIN_PASSWORD=


##############################################
# dbt (Data Build Tool)
##############################################

# dbt user in the DWH (used by the dbt container)
DWH_DBT_USER_PASSWORD=
